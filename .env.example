# Copy to apps/web/.env.local. Never commit real credentials or wallet keypairs.
# Only devnet and testnet are supported by this unaudited release.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Owner-reported Devnet deployment. Verify with scripts/verify-devnet.mjs before launch.
NEXT_PUBLIC_TRUSTLAYER_PROGRAM_ID=7v6PxWejvNneG5TwZSntgj5ZjV6sgLSengjkVsct6V2G
# The six-decimal SPL Token mint configured on-chain. Use test tokens only.
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Server-only upstream. Must match the network above. Defaults to public cluster RPC.
# Provider API keys belong here, NEVER in a NEXT_PUBLIC_ variable.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Supabase stores workspace records, never an unverified payment-state mirror.

# Public Supabase configuration is defaulted to the explicitly selected deployment
# in apps/web/lib/supabase/deployment.ts. Override these for a separate environment.
NEXT_PUBLIC_SUPABASE_URL=https://azyycklgfzmyxpztqugw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GnqX75t5QERfAiyPn8F-eQ_gby0WgKm
NEXT_PUBLIC_APP_URL=https://web-xi-nine-d4ej5g61wk.vercel.app
# Do not add a service-role key to the web app. Edge Functions use project-managed secrets.
